# Copy to .env and edit. Only ALLOWED_ORIGIN is required.

# The exact origin of the web app allowed to drive this agent
# (scheme + host + port, no trailing slash). This is the security gate.
ALLOWED_ORIGIN=https://your-web-app.example.com

# HTTP listener (loopback only, by design)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8765

# Comma-separated device drivers to load:
#   escpos_usb  -> ESC/POS receipt printer + cash drawer (USB)
#   hid_scale   -> USB HID shipping scale
#   zebra_zpl   -> Zebra ZPL label printer (Windows print share)
ENABLED_DRIVERS=escpos_usb

# --- escpos_usb -----------------------------------------------------------
# USB vendor/product id of the receipt printer (hex or decimal).
ESCPOS_VENDOR_ID=0x0519
ESCPOS_PRODUCT_ID=0x0001
ESCPOS_PROFILE=TSP100
DRAWER_PIN=2

# --- hid_scale ------------------------------------------------------------
# USB vendor/product id of the scale (hex or decimal).
SCALE_VENDOR_ID=0x0b67
SCALE_PRODUCT_ID=0x555e

# --- zebra_zpl ------------------------------------------------------------
# UNC path to the Zebra print share. Leave blank to auto-detect
# \\<this-machine-ip>\ZEBRA.
ZEBRA_TARGET=

# --- runtime --------------------------------------------------------------
PRINT_TEST_ON_STARTUP=false
TRAY_ICON_ENABLED=true
LOG_LEVEL=INFO
